# ==============================================================================
# 变量定义
# ==============================================================================

# C++ 编译器（必须使用 g++ 来链接 C++ 标准库）
CXX = g++

# 编译选项：
# -Wall: 开启所有常用警告
# -std=c++11: 使用 C++11 标准（可根据需要升级）
# -I.: 确保编译器在当前目录查找头文件 (.h)
# -MMD: 自动生成依赖文件 (.d)，用于追踪头文件依赖关系
CXXFLAGS = -Wall -std=c++11 -I. -MMD

# 目标文件（最终的可执行文件名称）
TARGET = main

# 源代码文件列表 (.cpp 文件)
# 根据你的错误信息，你的源代码文件是 Linecode.cpp
SRCS = main.cpp

# 推导出目标文件列表 (.o 文件)
OBJS = $(SRCS:.cpp=.o)

# 推导出依赖文件列表 (.d 文件)
DEPS = $(OBJS:.o=.d)


# ==============================================================================
# 规则定义
# ==============================================================================

# 默认规则：生成可执行文件
all: $(TARGET)

# -------------------- 1. 链接规则 --------------------
# 使用 $(CXX) (g++) 来链接所有的 .o 文件，确保链接 C++ 标准库
$(TARGET): $(OBJS)
	# 必须使用 Tab 缩进
	$(CXX) $(OBJS) -o $(TARGET)

# -------------------- 2. 编译规则 (模式匹配和自动依赖) --------------------
# 模式规则：如何从任何 .cpp 文件生成对应的 .o 文件
%.o: %.cpp
	# 必须使用 Tab 缩进
	$(CXX) $(CXXFLAGS) -c $< -o $@

# -------------------- 3. 包含依赖文件 --------------------
# 自动包含所有生成的 .d 依赖文件。如果 .h 文件被修改，对应的 .o 文件就会重新编译。
-include $(DEPS)


# -------------------- 4. 清理规则 --------------------
# .PHONY 标记 clean 目标总是可执行
.PHONY: clean
clean:
	# 必须使用 Tab 缩进
	rm -f $(OBJS) $(DEPS) $(TARGET)